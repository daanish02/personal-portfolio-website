---
import contactData from '../data/contact.json';
---
<header class="header">
    <nav class="nav container">
        <span class="name">Danish Ahmed</span>
        <a class="link" href="#experience">Experience</a>
        <a class="link" href="#projects">Projects</a>
        <a class="link" href="#credentials">Credentials</a>
        <a class="link" href="#education">Education</a>
        <a class="link" href="#leadership">Voluntary Work</a>
        <a class="link" href="#skills">Skills</a>
        <a class="link" href={contactData.github.url} target="_blank" rel="noopener noreferrer">Github</a>
        <a class="link" href={contactData.linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
</header>

<style>
.header {
    padding-top: 40px;
}

.nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
}

.name {
    font-weight: 600;
    color: var(--text);
    font-size: 17px;
    margin-right: 8px;
}

.link {
    color: var(--muted);
    font-size: 14px;
    border: none;
    text-decoration: none;
    transition: color var(--transition-fast);
}

.link:hover {
    color: var(--accent);
    border-bottom: none;
}
</style>
