---
import ExpandableCard from './ExpandableCard.astro';
import experienceData from '../data/experience.json';
import projectsData from '../data/projects.json';
import certificationsData from '../data/certifications.json';
import educationData from '../data/education.json';
import activitiesData from '../data/student-activities.json';
import skillsData from '../data/skills.json';

const top5Projects = projectsData.slice(0, 5);
const remainingProjects = projectsData.slice(5);
---

<div class="container">

    <!-- Experience -->
    <h2 class="label" id="experience">Experience</h2>
    {experienceData.map(item => (
        <ExpandableCard
            title={item.title}
            org={item.subtitle}
            date={item.period}
            overview={item.overview}
            details={item.details}
        />
    ))}

    <!-- Projects -->
    <h2 class="label" id="projects">Projects</h2>
    {top5Projects.map(item => (
        <ExpandableCard
            title={item.title}
            date={item.period}
            overview={item.overview}
            details={item.details}
        />
    ))}
    {remainingProjects.length > 0 && (
        <details class="more-projects">
            <summary class="more-summary">
                <span class="more-chev" aria-hidden="true">›</span>
                <span class="more-label">{remainingProjects.length} more projects</span>
            </summary>
            <div class="more-body">
                {remainingProjects.map(item => (
                    <ExpandableCard
                        title={item.title}
                        date={item.period}
                        overview={item.overview}
                        details={item.details}
                    />
                ))}
            </div>
        </details>
    )}

    <!-- Credentials -->
    <h2 class="label" id="credentials">Credentials</h2>
    {certificationsData.map(item => (
        <ExpandableCard
            title={item.title}
            org={item.issuer}
            date={item.date}
            overview={item.overview}
            details={item.details}
        />
    ))}

    <!-- Education -->
    <h2 class="label" id="education">Education</h2>
    {educationData.map(item => (
        <div class="edu-entry">
            <div class="edu-row">
                <h3 class="edu-degree">{item.degree}</h3>
                <span class="edu-date">{item.period}</span>
            </div>
            <div class="edu-institution">{item.institution}</div>
            {item.gpa && <div class="edu-gpa">{item.gpa}</div>}
        </div>
    ))}

    <!-- Leadership -->
    <h2 class="label" id="leadership">Voluntary Work</h2>
    {activitiesData.map(item => (
        <ExpandableCard
            title={item.title}
            org={item.organization}
            date={item.period}
            overview={item.overview}
            details={item.details}
        />
    ))}

    <!-- Skills -->
    <h2 class="label" id="skills">Skills</h2>
    <div class="techCloud skillsCloud">
        {skillsData.skills.map(skill => (
            <span class="techTag">
                {skill.icon && <img src={skill.icon} alt={skill.name} loading="lazy" width="14" height="14" />}
                {skill.name}
            </span>
        ))}
    </div>

</div>

<style>
.edu-entry {
    border-left: 1px solid var(--line);
    padding: 6px 0 6px 18px;
    margin-bottom: 16px;
}

.edu-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
}

.edu-degree {
    font-weight: 600;
    color: var(--text);
    font-size: 15px;
}

.edu-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--dim);
    white-space: nowrap;
    flex-shrink: 0;
}

.edu-institution {
    color: var(--muted);
    font-size: 14px;
    margin-top: 3px;
}

.edu-gpa {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    margin-top: 4px;
}

.more-projects {
    border-left: 1px solid var(--line);
    padding: 2px 0 2px 18px;
    margin-bottom: 6px;
}

.more-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 0;
    outline: none;
}

.more-summary::-webkit-details-marker { display: none; }

.more-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
}

.more-chev {
    font-family: var(--font-mono);
    color: var(--dim);
    transition: transform 0.2s;
    font-size: 12px;
    flex-shrink: 0;
}

.more-projects[open] .more-chev { transform: rotate(90deg); }

.more-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    border-radius: 3px;
    padding: 1px 6px;
}

.more-body { margin-top: 6px; }
</style>
