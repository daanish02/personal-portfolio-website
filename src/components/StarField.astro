<canvas id="starfield" aria-hidden="true" style="position:fixed;inset:0;z-index:0;pointer-events:none;display:block;"></canvas>

<script>
interface Star {
    x: number; y: number; r: number;
    baseBrightness: number; twinkleSpeed: number; twinklePhase: number;
    isAccent: boolean;
}
interface ShootingStar {
    x: number; y: number; dx: number; dy: number;
    tailLen: number; opacity: number; fading: boolean;
    life: number; maxLife: number;
}

const canvas = document.getElementById('starfield') as HTMLCanvasElement;
const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function accentRgb(): string {
    return getComputedStyle(document.documentElement).getPropertyValue('--accent-rgb').trim() || '251, 191, 36';
}

let animId: number;
let dpr = 1;
let stars: Star[] = [];
let edges: [number, number][] = [];
let shooting: ShootingStar | null = null;
let lastShootTime = 0;

function buildEdges() {
    edges = [];
    const MAX_DIST = 175;
    const MAX_EDGES = 28;
    for (let i = 0; i < stars.length && edges.length < MAX_EDGES; i++) {
        let conns = 0;
        for (let j = i + 1; j < stars.length && conns < 2 && edges.length < MAX_EDGES; j++) {
            const dx = stars[i].x - stars[j].x;
            const dy = stars[i].y - stars[j].y;
            if (dx * dx + dy * dy < MAX_DIST * MAX_DIST) {
                edges.push([i, j]);
                conns++;
            }
        }
    }
}

function buildStars(w: number, h: number) {
    const count = Math.max(60, Math.min(110, Math.floor((w * h) / 11000)));
    stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.1 + 0.5,
        baseBrightness: Math.random() * 0.55 + 0.25,
        twinkleSpeed: Math.random() * 0.0006 + 0.0002,
        twinklePhase: Math.random() * Math.PI * 2,
        isAccent: Math.random() < 0.11,
    }));
    buildEdges();
}

function resize() {
    dpr = window.devicePixelRatio || 1;
    const newW = window.innerWidth;
    const newH = window.innerHeight;

    if (stars.length > 0) {
        // Scale existing stars proportionally — no random jumps
        const oldW = canvas.width / dpr;
        const oldH = canvas.height / dpr;
        const scaleX = newW / oldW;
        const scaleY = newH / oldH;
        for (const s of stars) {
            s.x *= scaleX;
            s.y *= scaleY;
        }
        buildEdges();
    } else {
        buildStars(newW, newH);
    }

    canvas.width = newW * dpr;
    canvas.height = newH * dpr;
    canvas.style.width = `${newW}px`;
    canvas.style.height = `${newH}px`;
    ctx.scale(dpr, dpr);
}

function draw(t: number) {
    const w = canvas.width / dpr;
    const h = canvas.height / dpr;
    ctx.clearRect(0, 0, w, h);

    ctx.lineWidth = 0.4;
    for (const [i, j] of edges) {
        ctx.beginPath();
        ctx.strokeStyle = 'rgba(138, 146, 160, 0.09)';
        ctx.moveTo(stars[i].x, stars[i].y);
        ctx.lineTo(stars[j].x, stars[j].y);
        ctx.stroke();
    }

    for (const s of stars) {
        const tw = 0.72 + 0.28 * Math.sin(t * s.twinkleSpeed + s.twinklePhase);
        const alpha = s.baseBrightness * tw;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = s.isAccent
            ? `rgba(${accentRgb()}, ${alpha * 0.8})`
            : `rgba(200, 210, 220, ${alpha})`;
        ctx.fill();
    }

    if (shooting) {
        if (!shooting.fading) {
            shooting.opacity = Math.min(shooting.opacity + 0.05, 0.65);
            if (shooting.life > shooting.maxLife * 0.45) shooting.fading = true;
        } else {
            shooting.opacity = Math.max(shooting.opacity - 0.03, 0);
        }
        shooting.x += shooting.dx;
        shooting.y += shooting.dy;
        shooting.life++;
        if (shooting.opacity <= 0 || shooting.life > shooting.maxLife) {
            shooting = null;
        } else {
            const tx = shooting.x - shooting.dx * shooting.tailLen;
            const ty = shooting.y - shooting.dy * shooting.tailLen;
            const grad = ctx.createLinearGradient(tx, ty, shooting.x, shooting.y);
            grad.addColorStop(0, `rgba(${accentRgb()}, 0)`);
            grad.addColorStop(1, `rgba(255, 235, 180, ${shooting.opacity})`);
            ctx.beginPath();
            ctx.lineWidth = 1;
            ctx.strokeStyle = grad;
            ctx.moveTo(tx, ty);
            ctx.lineTo(shooting.x, shooting.y);
            ctx.stroke();
        }
    }

    if (!shooting && t - lastShootTime > 14000 + Math.random() * 8000) {
        const angle = (Math.random() * 25 + 20) * (Math.PI / 180);
        const diag = Math.sqrt(w * w + h * h);
        const scale = diag / 1000;
        const speed = scale * (7 + Math.random() * 5);
        shooting = {
            x: w * (0.05 + Math.random() * 0.65),
            y: h * (0.02 + Math.random() * 0.28),
            dx: Math.cos(angle) * speed,
            dy: Math.sin(angle) * speed,
            tailLen: scale * (14 + Math.random() * 10),
            opacity: 0, fading: false, life: 0,
            maxLife: 55 + Math.floor(Math.random() * 25),
        };
        lastShootTime = t;
    }
}

resize();

if (reducedMotion) {
    draw(0);
} else {
    const animate = (t: number) => { draw(t); animId = requestAnimationFrame(animate); };
    animId = requestAnimationFrame(animate);

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resize, 120);
    });
}
</script>
